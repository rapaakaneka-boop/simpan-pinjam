{
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@workspace/*": ["../../packages/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"],
  "extends": "../../packages/typescript-config/nextjs.json",
}
